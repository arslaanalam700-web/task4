# Environment Configuration for AI Market Demand & Growth Intelligence Agent
# Copy this file to .env and configure as needed.

# Application Environment (development, testing, production)
APP_ENV=development

# Optional Ollama Local LLM Configuration (fallback operates automatically if unset or offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional HuggingFace Inference API Key (strictly optional)
# HUGGINGFACE_API_KEY=your_token_here

# Collector Settings
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
USER_AGENT=MarketIntelligenceAgent/1.0 (Educational Research; +https://github.com/example/market-intelligence-agent)

# Storage
DATABASE_PATH=data/market_intelligence.db
